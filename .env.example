# =====================================================================
# CloudSearch — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =====================================================================

# ─── LLM Providers ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Model router policy: "privacy" | "cost" | "latency"
LLM_ROUTING_POLICY=cost

# ─── Web Search ──────────────────────────────────────────────────────
BRAVE_API_KEY=BSAa...
SERPER_API_KEY=...
SEARXNG_BASE_URL=http://localhost:8888

# ─── GitHub (code/GitHub mode) ───────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ─── Meilisearch ─────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=changeme-master-key
MEILISEARCH_INDEX_NAME=documents
# Embedding source for hybrid search: "openai" | "local" | "huggingface"
MEILISEARCH_EMBEDDER_SOURCE=local

# ─── Qdrant ──────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cloudsearch_chunks
QDRANT_VECTOR_SIZE=384

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─── Postgres ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudsearch
POSTGRES_USER=cloudsearch
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://cloudsearch:changeme@localhost:5432/cloudsearch

# ─── Kafka ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_QUERIES=cloudsearch.queries
KAFKA_TOPIC_RESULTS=cloudsearch.results
KAFKA_TOPIC_ANSWERS=cloudsearch.answers
KAFKA_GROUP_ID=cloudsearch-consumer-group

# ─── MinIO / S3 ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cloudsearch-docs
MINIO_SECURE=false

# ─── Elasticsearch ───────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Observability ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=cloudsearch
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ─── App Services ────────────────────────────────────────────────────
GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
RAG_PORT=8002
LLM_PORT=8003
WEB_PORT=3000

# Internal service URLs (used by gateway to call other services)
ORCHESTRATOR_URL=http://localhost:8001
RAG_URL=http://localhost:8002
LLM_URL=http://localhost:8003

# ─── Feature Flags ───────────────────────────────────────────────────
ENABLE_KAFKA=true
ENABLE_GRAPHRAG=false
ENABLE_RAPTOR=false
ENABLE_LOCAL_PROVIDER=true
ENABLE_PRIVATE_PROVIDER=false
ENABLE_CODE_PROVIDER=false
